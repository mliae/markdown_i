# Markdown-i Nginx 反代配置（阿里云 / 宝塔）
# 部署：替换 YOUR_DOMAIN 后放到 /www/server/panel/vhost/nginx/markdown-i.conf，nginx -t 后 reload
# HTTPS 证书路径以宝塔实际签发为准（或 certbot）

# 带 ?v= 指纹参数的静态资源：强缓存 + immutable（与 Node 端 AssetsFetcher 策略一致）
map $arg_v $mdi_immutable {
    ""      "";
    default "public, max-age=31536000, immutable";
}

# gzip（所有 Nginx 默认自带）
gzip on;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_vary on;
gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml text/javascript application/wasm;
# brotli（需 Nginx 已装 brotli 模块，宝塔可在「软件商店 - Nginx - 安装扩展」加装；没装就删掉下面 4 行）
# brotli on;
# brotli_comp_level 6;
# brotli_types text/css application/javascript application/json image/svg+xml application/wasm;
# brotli_static on;

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    listen [::]:443 ssl;
    server_name YOUR_DOMAIN;

    ssl_certificate     /www/server/panel/vhost/cert/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/YOUR_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # 站点代码目录（静态资源直接由 Nginx 读 public/，不经过 Node）
    root /www/wwwsites/markdown-i/public;

    # 视频等大文件上传
    client_max_body_size 200m;
    client_body_buffer_size 1m;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    # 静态文件：命中 public/ 直接返回，未命中回源 Node（含 ?v= 强缓存）
    # 注意不要把 index.html 放进来——SSR 头注入（OG/标题）必须经过 Node
    location ~* \.(?:js|css|json|wasm|png|jpg|jpeg|gif|webp|avif|svg|ico|woff2?|ttf|eot|mp4|webm|mp3|m4a|map)$ {
        try_files $uri @node;
        add_header Cache-Control $mdi_immutable always;
        access_log off;
    }

    location = /robots.txt { try_files /robots.txt @node; access_log off; }
    location = /favicon.ico { try_files /favicon.ico @node; access_log off; }

    # 其余全部走 Node（页面 SSR、/api/、/media/、/rss.xml 等）
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # /media/ 视频 Range 请求需要透传，不缓冲整文件
        proxy_buffering off;
    }

    location @node {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}
