# Markdown-i Nginx 反代配置（阿里云 / 宝塔 Tengine 实测可用版本）
# 部署：替换域名、证书路径后放到 /www/server/panel/vhost/nginx/markdown-i.conf
# 注意：若 apex 已被别的宝塔站点占用（server_name 里同时含主域），
#       需把旧配置的 server_name 改为只保留 www（先备份 conf）。
# 校验：nginx -t && nginx -s reload

map $arg_v $mdi_cache {
    ""      "public, max-age=300";
    default "public, max-age=31536000, immutable";
}

server {
    listen 80;
    server_name YOUR_DOMAIN;

    # 证书续签验证（宝塔 Let's Encrypt webroot）
    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/YOUR_DOMAIN;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name YOUR_DOMAIN;

    ssl_certificate     /www/server/panel/vhost/cert/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/YOUR_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers EECDH+CHACHA20:EECDH+AES128:RSA+AES128:EECDH+AES256:RSA+AES256:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL_MDI:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # 视频等大文件上传
    client_max_body_size 200m;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    # 经反代的 JSON/SSR 文本响应也压缩
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml text/javascript application/wasm application/manifest+json;

    access_log /www/wwwlogs/markdown-i.log;
    error_log  /www/wwwlogs/markdown-i.error.log;

    # 站点代码目录：静态资源由 Nginx 直读（命中才直出，未命中回源 Node）
    root /www/wwwsites/markdown-i/public;

    # index.html 不匹配这些扩展名 → 仍走 Node SSR（OG/title 注入）
    location ~* \.(?:js|css|json|wasm|png|jpg|jpeg|gif|webp|avif|svg|ico|woff2?|ttf|eot|mp4|webm|mp3|m4a)$ {
        try_files $uri @node;
        add_header Cache-Control $mdi_cache always;
        access_log off;
    }

    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/YOUR_DOMAIN;
        default_type "text/plain";
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # /media/ Range 请求与上传流不缓冲整文件
        proxy_buffering off;
    }

    location @node {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
    }
}
